# Secrets and connection strings only. Non-sensitive settings live in config/config.json.
# Environment variables override config.json when both are set.

# Host port the web app is published on (Docker Compose only).
WEB_PORT=9100

# MongoDB URI for both web and vulnerabilities databases (same server, different DB names).
# MONGO_URI overrides LOCAL_MONGO_URI when both are set.
LOCAL_MONGO_URI=mongodb://localhost:27017/
# Docker Compose overrides LOCAL_MONGO_URI with this URI (as seen from inside the
# container, default host.docker.internal). Only needed when Mongo is not on the host.
LOCAL_MONGO_URI_DOCKER=
FLASK_SECRET_KEY=change-me

TAVILY_API_KEY=
TAVILY_API_KEYS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
