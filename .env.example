# Secrets and connection strings only. Non-sensitive settings live in config/config.json.
# Environment variables override config.json when both are set.

# MongoDB URI for both web and vulnerabilities databases (same server, different DB names).
# MONGO_URI overrides LOCAL_MONGO_URI when both are set.
LOCAL_MONGO_URI=mongodb://localhost:27017/
# Docker Compose overrides LOCAL_MONGO_URI to host.docker.internal for web.
FLASK_SECRET_KEY=change-me

# Account Hub OAuth (set ACCOUNT_HUB_ENABLED=true after registering the client).
# Use the full URLs supplied by the Account Hub deployment; do not infer path composition.
ACCOUNT_HUB_ENABLED=false
ACCOUNT_HUB_AUTHORIZE_URL=
ACCOUNT_HUB_TOKEN_URL=
ACCOUNT_HUB_TOKEN_CHECK_URL=
ACCOUNT_HUB_LOGOUT_URL=
ACCOUNT_HUB_CLIENT_ID=
ACCOUNT_HUB_CLIENT_SECRET=
ACCOUNT_HUB_REDIRECT_URI=
ACCOUNT_HUB_ADMIN_PERMISSION=
ACCOUNT_HUB_SUB_ADMIN_PERMISSION=
ACCOUNT_HUB_SCOPE=openid
ACCOUNT_HUB_TIMEOUT_SECONDS=5

TAVILY_API_KEY=
TAVILY_API_KEYS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
